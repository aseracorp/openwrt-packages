#!/bin/sh /etc/rc.common
# desc: Cosmos Cloud secure gateway/server (Cosmos Cloud)
# processname: cosmos

START=99
STOP=01
USE_PROCD=1

# Cosmos Cloud is launched via a small start script that first runs the
# network-prep binary (cosmos-launcher) and then the main server (cosmos),
# mirroring the upstream /opt/cosmos/start.sh flow. We run it through bash
# so procd tracks a single foreground process (the server) for correct
# start/stop/respawn semantics.
#
# On Cosmos OpenWrt images, /bin/CosmosInit (a Go binary shipped in the
# image overlay, not part of this package) performs the first-boot
# commissioning + config sync and then exits 0. /bin/CosmosInit is part of
# the procd command (NOT a one-shot in start_service), so it runs before
# EVERY cosmos start, not just the first one. That matters because the setup
# wizard restarts the server via os.Exit(0): procd respawns only the command
# (never start_service), and the server's in-memory config rewrite drops the
# Asera-owned keys (theme colours, resiSTORE market, Support Access cron) —
# the pre-start CosmosInit run re-applies them. The commissioning is
# idempotent (guarded by init.conf) and may reboot only on a fresh install,
# before the launcher ever runs. When CosmosInit is not present (plain
# cosmoscloud package on stock OpenWrt), we skip it and start directly.

start_service() {
	procd_open_instance
	# Commission + config sync, then launch via the upstream start flow:
	# prepare network with cosmos-launcher, then exec the main server so
	# procd tracks the live cosmos process. CosmosInit runs before EVERY
	# cosmos start because it is inside the command that procd respawns.
	# LEGO_DISABLE_CNAME_SUPPORT avoids local Let's Encrypt (lego) failures
	# when the DNS challenge uses CNAME records. COSMOS_CONFIG_FOLDER keeps
	# the persistent configuration in /etc/cosmos.
	procd_set_param command /bin/bash -c "[ -x /bin/CosmosInit ] && /bin/CosmosInit; cd /opt/cosmos && ./cosmos-launcher && exec ./cosmos"
	procd_set_param env COSMOS_CONFIG_FOLDER=/etc/cosmos/ LEGO_DISABLE_CNAME_SUPPORT=true
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 150 10 10
	procd_set_param term_timeout 60
	procd_close_instance
}

stop_service() {
	# procd stops the tracked (main) process on its own; additionally make sure
	# the launcher and server are gone in case they escaped as separate pids.
	kill "$(pidof cosmos-launcher)" 2>/dev/null
	kill -SIGTERM "$(pidof cosmos)" 2>/dev/null
	procd_kill cosmos 2>/dev/null
}
